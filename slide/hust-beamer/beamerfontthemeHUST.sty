%% beamerfontthemeHUST.sty -- Typography configuration for the HUST Beamer theme
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerfontthemeHUST}[2026/10/26 HUST Beamer font theme]

\mode<presentation>

\RequirePackage{fontspec}

%% Font selection based on theme option: font = lato | arial | times | cm
\def\hust@opt@lato{lato}
\def\hust@opt@arial{arial}
\def\hust@opt@times{times}
\def\hust@opt@cm{cm}

\ifx\hust@fontsel\hust@opt@arial
  \setsansfont{Arial}[Ligatures=TeX]
  \setmainfont{Arial}[Ligatures=TeX]
\else\ifx\hust@fontsel\hust@opt@times
  \setsansfont{Times New Roman}[Ligatures=TeX]
  \setmainfont{Times New Roman}[Ligatures=TeX]
\else\ifx\hust@fontsel\hust@opt@cm
  \IfFontExistsTF{Latin Modern Sans}{%
    \setsansfont{Latin Modern Sans}[Ligatures=TeX]
    \setmainfont{Latin Modern Roman}[Ligatures=TeX]
  }{%
    \setsansfont{LMSans10-Regular}[Ligatures=TeX]
    \setmainfont{LMRoman10-Regular}[Ligatures=TeX]
  }
\else
  %% Default: Lato
  \IfFontExistsTF{Lato}{%
    \setsansfont{Lato}[Ligatures=TeX]
    \setmainfont{Lato}[Ligatures=TeX]
  }{%
    \setsansfont{Arial}[Ligatures=TeX]
    \setmainfont{Arial}[Ligatures=TeX]
  }
\fi\fi\fi

%% Title font option: titlefont = same | avantgarde
\def\hust@opt@avantgarde{avantgarde}
\ifx\hust@tfontsel\hust@opt@avantgarde
  \IfFontExistsTF{TeX Gyre Adventor}{%
    \newfontfamily\hust@titlefamily{TeX Gyre Adventor}[Ligatures=TeX, WordSpace={0.8}]
  }{%
    \IfFontExistsTF{AvantGarde}{%
      \newfontfamily\hust@titlefamily{AvantGarde}[Ligatures=TeX, WordSpace={0.8}]
    }{%
      \let\hust@titlefamily\relax
    }
  }
\else
  \let\hust@titlefamily\relax
\fi

%% Official brand typeface for slogan & lockups (never changes with document font)
\IfFontExistsTF{TeX Gyre Adventor}{%
  \newfontfamily\hust@brandfamily{TeX Gyre Adventor}[Ligatures=TeX]
}{%
  \IfFontExistsTF{AvantGarde}{%
    \newfontfamily\hust@brandfamily{AvantGarde}[Ligatures=TeX]
  }{%
    \IfFontExistsTF{Arial}{%
      \newfontfamily\hust@brandfamily{Arial}[Ligatures=TeX]
    }{%
      \let\hust@brandfamily\sffamily
    }%
  }%
}

%% Beamer font sizes and weights matching HUST brand guidelines & PPTX master
\setbeamerfont{title}{family=\hust@titlefamily, series=\bfseries, size=\Large}
\setbeamerfont{subtitle}{series=\normalfont, size=\small}
\setbeamerfont{author}{series=\bfseries, size=\small}
\setbeamerfont{institute}{series=\normalfont, size=\footnotesize}
\setbeamerfont{date}{series=\normalfont, size=\scriptsize}

\setbeamerfont{frametitle}{family=\hust@titlefamily, series=\bfseries, size=\normalsize}
\setbeamerfont{framesubtitle}{family=\hust@titlefamily, series=\bfseries, size=\scriptsize}

\setbeamerfont{block title}{series=\bfseries, size=\small}
\setbeamerfont{block body}{size=\small}

\setbeamerfont{section in toc}{series=\bfseries, size=\normalsize}
\setbeamerfont{subsection in toc}{size=\small}

\setbeamerfont{footline}{series=\bfseries, size=\tiny}
\setbeamerfont{footermeta}{size=\tiny}
\setbeamerfont{page number in head/foot}{series=\bfseries, size=\tiny}
\setbeamerfont{slogan}{family=\hust@brandfamily, series=\bfseries, size=\small}
\setbeamerfont{footnote}{size=\tiny}

\mode<all>
\endinput
