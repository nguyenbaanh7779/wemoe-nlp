%% ------------------------------------------------------------ Vietnamese Date Format
\newcommand{\hust@set@today}{%
  \def\today{%
    \ifhust@dateaddress
      \ifx\hust@date@address\@empty
        ngày \number\day\ tháng \number\month\ năm \number\year
      \else
        \hust@date@address, ngày \number\day\ tháng \number\month\ năm \number\year
      \fi
    \else
      ngày \number\day\ tháng \number\month\ năm \number\year
    \fi
  }%
}
\hust@set@today
\AtBeginDocument{\hust@set@today}

%% Helper to output an arbitrary Vietnamese date with optional custom address:
%%   \hustdate{8}{7}{2025} -> "Hà Nội, ngày 8 tháng 7 năm 2025" (when address is on)
%%   \hustdate[TP. Hồ Chí Minh]{8}{7}{2025} -> "TP. Hồ Chí Minh, ngày 8 tháng 7 năm 2025"
%%   \hustdate[none]{8}{7}{2025} -> "ngày 8 tháng 7 năm 2025"
\newcommand{\hustdate}[4][]{%
  \gdef\hust@recorded@shortdate{\ifnum#2<10 0\fi\number#2/\ifnum#3<10 0\fi\number#3/\number#4}%
  \begingroup
    \def\hust@tmp@addr{\hust@date@address}%
    \ifstrempty{#1}{}{%
      \ifstrequal{#1}{none}{\def\hust@tmp@addr{}}{%
        \ifstrequal{#1}{off}{\def\hust@tmp@addr{}}{%
          \ifstrequal{#1}{false}{\def\hust@tmp@addr{}}{%
            \def\hust@tmp@addr{#1}%
          }%
        }%
      }%
    }%
    \ifhust@dateaddress
      \ifx\hust@tmp@addr\@empty
        ngày #2 tháng #3 năm #4%
      \else
        \hust@tmp@addr, ngày #2 tháng #3 năm #4%
      \fi
    \else
      \ifstrempty{#1}{%
        ngày #2 tháng #3 năm #4%
      }{%
        \ifstrequal{#1}{none}{ngày #2 tháng #3 năm #4}{%
          \ifstrequal{#1}{off}{ngày #2 tháng #3 năm #4}{%
            #1, ngày #2 tháng #3 năm #4%
          }%
        }%
      }%
    \fi
  \endgroup
}
\let\vntoday\today
\let\vietnamesedate\today

%% Short date format (DD/MM/YYYY):
\newcommand{\hust@dateshort}{%
  \ifx\hust@recorded@shortdate\@empty
    \ifnum\day<10 0\fi\number\day/%
    \ifnum\month<10 0\fi\number\month/%
    \number\year
  \else
    \hust@recorded@shortdate
  \fi
}

