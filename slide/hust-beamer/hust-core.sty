        %% Case 4a: 2 lines VN + separator rule at center + 2 lines Unit (Symmetric)
        \node[inner sep=0pt, outer sep=0pt, anchor=south west, align=left] (top)
          at ([xshift=\hust@lgap@dim, yshift=0.04\hust@lh@dim] shield.east) {\usebox\hust@topbox};
        \draw[\hust@llcol, line width=0.7pt]
          ([xshift=\hust@lgap@dim] shield.east) -- ([xshift=\dimexpr\hust@lgap@dim + \hust@rule@w\relax] shield.east);
        \node[inner sep=0pt, outer sep=0pt, anchor=north west, align=left] (bot)
          at ([xshift=\hust@lgap@dim, yshift=-0.04\hust@lh@dim] shield.east) {\usebox\hust@botbox};
      \else
        \ifnum\hust@do@fourb=1
          %% Case 4b: 1 line VN + separator rule + 2 lines Unit (Cluster pushed up to center on shield)
          \node[inner sep=0pt, outer sep=0pt, anchor=south west] (top)
            at ([xshift=\hust@lgap@dim, yshift=0.16\hust@lh@dim] shield.east) {\usebox\hust@topbox};
          \draw[\hust@llcol, line width=0.7pt]
            ([xshift=\hust@lgap@dim, yshift=0.095\hust@lh@dim] shield.east) --
            ([xshift=\dimexpr\hust@lgap@dim + \hust@rule@w\relax, yshift=0.095\hust@lh@dim] shield.east);
          \node[inner sep=0pt, outer sep=0pt, anchor=north west, align=left] (bot)
            at ([xshift=\hust@lgap@dim, yshift=0.035\hust@lh@dim] shield.east) {\usebox\hust@botbox};
        \else
          %% Case 3: 1 line VN + separator rule + 1 line Unit (Measured from official Hình 9a lockup)
          \node[inner sep=0pt, outer sep=0pt, anchor=base west] (top)
            at ([xshift=\hust@lgap@dim, yshift=0.167\hust@lh@dim] shield.east) {\usebox\hust@topbox};
          \draw[\hust@llcol, line width=0.75pt]
            ([xshift=\hust@lgap@dim, yshift=0.042\hust@lh@dim] shield.east) --
            ([xshift=\dimexpr\hust@lgap@dim + \hust@rule@w\relax, yshift=0.042\hust@lh@dim] shield.east);
          \node[inner sep=0pt, outer sep=0pt, anchor=base west] (bot)
            at ([xshift=\hust@lgap@dim, yshift=-0.300\hust@lh@dim] shield.east) {\usebox\hust@botbox};
        \fi
      \fi
    \fi
  \end{tikzpicture}%
  \endgroup
}

%% ------------------------------------------------------------ HUST Wordmark Lockup (Hình 14)
%% Combines footer-hust.png (or footer-hust-white.png) with 2 lines:
%%   Line 1: ĐẠI HỌC BÁCH KHOA HÀ NỘI (Bold)
%%   Line 2: HANOI UNIVERSITY OF SCIENCE AND TECHNOLOGY (Regular)
%% Per guidebook Hình 14:
%% - Width of both lines matches the exact width of the HUST logo
%% - Height of both lines combined <= logo height x
%% - Gap between logo and Line 1 is ~ 1/3x
\newdimen\hust@wm@h@dim
\newsavebox\hust@wm@imgbox
\newsavebox\hust@wm@vnbox
\newsavebox\hust@wm@enbox

\newcommand{\hustwordmarklockup}[1][]{%
  \begingroup
  \def\hust@wm@col{white}%
  \def\hust@wm@h{0.11\paperheight}%
  \def\hust@wm@img{footer-hust-white.png}%
  \pgfkeys{/hust/wordmarklockup/.cd,
    color/.store in=\hust@wm@col,
    height/.store in=\hust@wm@h,
    image/.store in=\hust@wm@img,
    #1%
  }%
  \hust@wm@h@dim=\hust@wm@h\relax
  \sbox\hust@wm@imgbox{\includegraphics[height=\hust@wm@h@dim]{\hust@wm@img}}%
  \sbox\hust@wm@vnbox{{\hust@logofont\fontsize{0.25\hust@wm@h@dim}{0.25\hust@wm@h@dim}\selectfont\bfseries\color{\hust@wm@col}ĐẠI HỌC BÁCH KHOA HÀ NỘI}}%
  \sbox\hust@wm@enbox{{\hust@logofont\fontsize{0.14\hust@wm@h@dim}{0.14\hust@wm@h@dim}\selectfont\mdseries\color{\hust@wm@col}HANOI UNIVERSITY OF SCIENCE AND TECHNOLOGY}}%
  \vbox{%
    \offinterlineskip%
    \hbox{\usebox\hust@wm@imgbox}%
    \vskip 0.33333\hust@wm@h@dim%
    \hbox{\resizebox{\wd\hust@wm@imgbox}{!}{\usebox\hust@wm@vnbox}}%
    \vskip 0.08\hust@wm@h@dim%
    \hbox{\resizebox{\wd\hust@wm@imgbox}{!}{\usebox\hust@wm@enbox}}%
  }%
  \endgroup
}

