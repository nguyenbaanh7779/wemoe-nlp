%% Build 1-column and 2-column single-line boxes for plain footnotes / \note
%% #1 = mark color (hustmain for \footnote/\cite, hustaccent for \note)
%% #2 = mark symbol, #3 = max chars, #4 = text
\newcommand{\hust@make@notebox}[4]{%
  \sbox\hust@tmp@cbox{%
    \usebeamerfont{footnote}\selectfont\strut%
    {\color{#1}\usebeamerfont*{footnote mark}\textsuperscript{#2}}\,%
    {\usebeamercolor[fg]{footnote}\husttruncate{#3}{#4}}\strut%
  }%
}

\newcommand{\hust@add@raw@footeritem}[3]{%
  \global\advance\c@hust@slide@citecount by 1\relax%
  \hust@update@footcite@left%
  \ifnum\c@hust@slide@citecount<9\relax
    \edef\hust@cur@slot{\romannumeral\c@hust@slide@citecount}%
    %% 1-column box (auto-fit to 1 line, or keep intact if -1)
    \ifnum\hust@citemax=-1\relax
      \hust@make@notebox{#1}{#2}{-1}{#3}%
      \ifdim\wd\hust@tmp@cbox>\hust@cite@onecol@w
        \sbox\hust@tmp@cbox{\resizebox{\hust@cite@onecol@w}{\height}{\usebox\hust@tmp@cbox}}%
      \fi
    \else
      \hust@make@notebox{#1}{#2}{115}{#3}%
      \ifdim\wd\hust@tmp@cbox>\hust@cite@onecol@w \hust@make@notebox{#1}{#2}{90}{#3}\fi
      \ifdim\wd\hust@tmp@cbox>\hust@cite@onecol@w \hust@make@notebox{#1}{#2}{72}{#3}\fi
      \ifdim\wd\hust@tmp@cbox>\hust@cite@onecol@w \hust@make@notebox{#1}{#2}{56}{#3}\fi
      \ifdim\wd\hust@tmp@cbox>\hust@cite@onecol@w \hust@make@notebox{#1}{#2}{42}{#3}\fi
      \ifdim\wd\hust@tmp@cbox>\hust@cite@onecol@w
        \sbox\hust@tmp@cbox{\resizebox{\hust@cite@onecol@w}{\height}{\usebox\hust@tmp@cbox}}%
      \fi
    \fi
    \global\setbox\csname hust@citebox@one@\hust@cur@slot\endcsname=\hbox{\unhbox\hust@tmp@cbox}%
    %% 2-column box (auto-fit to half-column line, or keep intact if -1)
    \ifnum\hust@citemax=-1\relax
      \hust@make@notebox{#1}{#2}{-1}{#3}%
      \ifdim\wd\hust@tmp@cbox>\hust@cite@twocol@w
        \sbox\hust@tmp@cbox{\resizebox{\hust@cite@twocol@w}{\height}{\usebox\hust@tmp@cbox}}%
      \fi
    \else
      \hust@make@notebox{#1}{#2}{52}{#3}%
      \ifdim\wd\hust@tmp@cbox>\hust@cite@twocol@w \hust@make@notebox{#1}{#2}{40}{#3}\fi
      \ifdim\wd\hust@tmp@cbox>\hust@cite@twocol@w \hust@make@notebox{#1}{#2}{30}{#3}\fi
      \ifdim\wd\hust@tmp@cbox>\hust@cite@twocol@w \hust@make@notebox{#1}{#2}{22}{#3}\fi
      \ifdim\wd\hust@tmp@cbox>\hust@cite@twocol@w
        \sbox\hust@tmp@cbox{\resizebox{\hust@cite@twocol@w}{\height}{\usebox\hust@tmp@cbox}}%
      \fi
    \fi
    \global\setbox\csname hust@citebox@two@\hust@cur@slot\endcsname=\hbox{\unhbox\hust@tmp@cbox}%
  \fi
}

%% Assemble \hust@slide@citebox at the end of the frame (locked to max 4 lines)
\newcommand{\hust@build@slide@citebox}{%
  \global\setbox\hust@slide@citebox=\box\voidb@x%
  \gdef\hust@cite@rows{0}%
  \ifnum\c@hust@slide@citecount>0\relax
    \hust@update@footcite@left%
    \count@=\c@hust@slide@citecount\relax
    \ifnum\count@>\hust@citemax\relax \count@=\hust@citemax\relax \fi
    \ifnum\count@>8\relax \count@=8\relax \fi
    \edef\hust@eff@citecount{\the\count@}%
    \hust@use@twocolfalse
    \def\hust@tmp@ccol{2}%
    \ifx\hust@citecolumns\hust@tmp@ccol
      \ifnum\hust@eff@citecount>1\relax \hust@use@twocoltrue \fi
    \else
      \def\hust@tmp@ccol{auto}%
      \ifx\hust@citecolumns\hust@tmp@ccol
        \ifnum\hust@eff@citecount>\hust@citemaxlines\relax \hust@use@twocoltrue \fi
      \fi
    \fi
    \ifhust@use@twocol
      \count@=\numexpr\hust@eff@citecount + 1\relax
      \divide\count@ by 2\relax
      \ifnum\count@>\hust@citemaxlines\relax \count@=\hust@citemaxlines\relax \fi
      \ifnum\count@>4\relax \count@=4\relax \fi
      \xdef\hust@cite@rows{\the\count@}%
      \global\setbox\hust@slide@citebox=\vbox{%
        \count255=1\relax
        \loop
          \hbox to \hust@cite@onecol@w{%
            \hbox to \hust@cite@twocol@w{\unhcopy\csname hust@citebox@two@\romannumeral\count255\endcsname\hss}%
            \hfill
            \count@=\numexpr\count255 + \hust@cite@rows\relax
            \unless\ifnum\count@>\hust@eff@citecount\relax
              \hbox to \hust@cite@twocol@w{\unhcopy\csname hust@citebox@two@\romannumeral\count@\endcsname\hss}%
            \else
              \hbox to \hust@cite@twocol@w{\hss}%
            \fi
          }%
          \ifnum\count255<\hust@cite@rows\relax
            \vskip 0.8pt%
          \fi
          \advance\count255 by 1\relax
        \unless\ifnum\count255>\hust@cite@rows\relax \repeat
      }%
    \else
      \count@=\hust@eff@citecount\relax
      \ifnum\count@>\hust@citemaxlines\relax \count@=\hust@citemaxlines\relax \fi
      \ifnum\count@>4\relax \count@=4\relax \fi
      \xdef\hust@cite@rows{\the\count@}%
      \global\setbox\hust@slide@citebox=\vbox{%
        \count255=1\relax
        \loop
          \hbox to \hust@cite@onecol@w{\unhcopy\csname hust@citebox@one@\romannumeral\count255\endcsname\hss}%
          \ifnum\count255<\hust@cite@rows\relax
            \vskip 0.8pt%
          \fi
          \advance\count255 by 1\relax
        \unless\ifnum\count255>\hust@cite@rows\relax \repeat
      }%
    \fi
  \fi
}

