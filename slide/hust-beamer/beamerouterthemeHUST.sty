\newdimen\hust@footcite@left
\newdimen\hust@cite@onecol@w
\newdimen\hust@cite@twocol@w
\newcommand{\hust@update@footcite@left}{%
  \def\hust@cur@lw{0pt}%
  \def\hust@cur@lgap{0pt}%
  \ifx\hust@flogo\hust@logo@full
    \def\hust@cur@lw{\hust@fW{fullW}}%
    \def\hust@cur@lgap{\hust@fW{gapfull}}%
  \else\ifx\hust@flogo\hust@logo@mark
    \def\hust@cur@lw{\hust@fW{markW}}%
    \def\hust@cur@lgap{\hust@fW{gapmark}}%
  \else\ifx\hust@flogo\hust@logo@wordmark
    \def\hust@cur@lw{\hust@fW{wordmarkW}}%
    \def\hust@cur@lgap{\hust@fW{gapwordmark}}%
  \else\ifx\hust@flogo\hust@logo@hust
    \def\hust@cur@lw{\hust@fW{hustW}}%
    \def\hust@cur@lgap{\hust@fW{gaphust}}%
  \fi\fi\fi\fi
  \ifdim\hust@cur@lw>0pt
    \setlength{\hust@footcite@left}{\dimexpr\hust@fW{footX} + \hust@cur@lw + \hust@cur@lgap - \hust@fW{mL}\relax}%
    \ifdim\hust@footcite@left<0pt\setlength{\hust@footcite@left}{0pt}\fi
  \else
    \setlength{\hust@footcite@left}{0pt}%
  \fi
  \ifx\hust@headerright\hust@hdr@pagenumber
    \setlength{\hust@cite@onecol@w}{\dimexpr\hust@fW{footXend} - (\hust@fW{footX} + \hust@cur@lw + \hust@cur@lgap)\relax}%
  \else
    \setlength{\hust@cite@onecol@w}{\dimexpr\paperwidth - (\hust@fW{footX} + \hust@cur@lw + \hust@cur@lgap) - 0.07\paperwidth\relax}%
  \fi
  \setlength{\hust@cite@twocol@w}{\dimexpr 0.485\hust@cite@onecol@w\relax}%
}

