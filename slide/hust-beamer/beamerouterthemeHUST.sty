
%% beamerouterthemeHUST.sty -- Outer layout: header band, frametitle, footer for HUST theme
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerouterthemeHUST}[2026/10/26 HUST Beamer outer theme]

\mode<presentation>

\RequirePackage{tikz}

%% Disable navigation symbols for clean presentation
\setbeamertemplate{navigation symbols}{}

%% Margins
\setbeamersize{text margin left=\hust@fW{mL}, text margin right=\hust@fW{mL}}

%% ----------------------------------------------------------- Progress Bar & Section Tracking
\def\hust@nav@totalsecs{0}

\newcommand{\hust@read@nav}{%
  \ifnum\beamer@totalheads>0\relax
    \begingroup
      \def\slideentry##1##2##3##4##5##6{}%
      \def\beamer@framepages##1##2{}%
      \def\beamer@sectionpages##1##2{}%
      \def\beamer@subsectionpages##1##2{}%
      \def\beamer@partpages##1##2{}%
      \def\beamer@documentpages##1{}%
      \def\sectionentry##1##2##3##4##5{%
        \global\expandafter\def\csname hust@nav@sectitle@##1\endcsname{##4}%
        \def\hust@tmp@short{##2}%
        \ifx\hust@tmp@short\@empty
          \global\expandafter\def\csname hust@nav@secshort@##1\endcsname{##4}%
        \else
          \global\expandafter\def\csname hust@nav@secshort@##1\endcsname{##2}%
        \fi
        \global\expandafter\def\csname hust@nav@secpage@##1\endcsname{##3}%
        \ifcsname hust@nav@subcount@##1\endcsname\else
          \global\expandafter\def\csname hust@nav@subcount@##1\endcsname{0}%
        \fi
        \ifnum##1>\hust@nav@totalsecs\relax
          \xdef\hust@nav@totalsecs{##1}%
        \fi
      }%
      \def\beamer@subsectionentry##1##2##3##4##5{%
        \global\expandafter\def\csname hust@nav@subcount@##2\endcsname{##3}%
        \global\expandafter\def\csname hust@nav@subpage@##2@##3\endcsname{##4}%
      }%
      \gdef\hust@nav@totalsecs{0}%
      \dohead
    \endgroup
  \fi
}

\newdimen\hust@sec@w
\newdimen\hust@bar@w
\newdimen\hust@bar@gap
\newdimen\hust@bar@pad
\newdimen\hust@bar@step
\newdimen\hust@bar@avail
\newdimen\hust@sec@xl
\newdimen\hust@sec@xr
\newdimen\hust@sec@xm
\newdimen\hust@bar@xl
\newdimen\hust@bar@xr
\newdimen\hust@bar@ybot
\newdimen\hust@bar@ytop
\newcount\hust@sec@idx
\newcount\hust@sub@idx
\newcount\hust@sec@total
\newcount\hust@sub@total

\newcommand{\hust@draw@subbars@active}{%
  \ifnum\hust@sub@idx>\hust@sub@total\else
    \setlength{\hust@bar@xl}{\dimexpr\hust@sec@xl + \hust@bar@pad + \hust@bar@step * \numexpr\hust@sub@idx - 1\relax\relax}%
    \setlength{\hust@bar@xr}{\dimexpr\hust@bar@xl + \hust@bar@w\relax}%
    \ifcsname hust@nav@subpage@\the\hust@sec@idx @\the\hust@sub@idx\endcsname
      \expandafter\let\expandafter\hust@cur@subpage\csname hust@nav@subpage@\the\hust@sec@idx @\the\hust@sub@idx\endcsname
    \else
      \def\hust@cur@subpage{}%
    \fi
    \ifnum\hust@sub@idx=\c@subsection\relax
      \fill[hustyellow] ([xshift=\hust@bar@xl, yshift=\hust@bar@ybot] current page.north west) rectangle
        ([xshift=\hust@bar@xr, yshift=\hust@bar@ytop] current page.north west);
    \else
      \ifx\hust@colname\hust@col@red
        \fill[hustlightred] ([xshift=\hust@bar@xl, yshift=\hust@bar@ybot] current page.north west) rectangle
          ([xshift=\hust@bar@xr, yshift=\hust@bar@ytop] current page.north west);
      \else
        \fill[hustlightblue] ([xshift=\hust@bar@xl, yshift=\hust@bar@ybot] current page.north west) rectangle
          ([xshift=\hust@bar@xr, yshift=\hust@bar@ytop] current page.north west);
      \fi
    \fi
    \ifx\hust@cur@subpage\@empty\else
      \node[anchor=south west, inner sep=0pt, outer sep=0pt]
        at ([xshift=\hust@bar@xl, yshift=\hust@bar@ybot] current page.north west) {%
          \hyperlink{Navigation\hust@cur@subpage}{\phantom{\rule{\hust@bar@w}{\dimexpr\hust@bar@ytop - \hust@bar@ybot + 2.5pt\relax}}}%
        };
    \fi
    \advance\hust@sub@idx by 1\relax
    \expandafter\hust@draw@subbars@active
  \fi
}

\newcommand{\hust@draw@subbars@inactive}{%
  \ifnum\hust@sub@idx>\hust@sub@total\else
    \setlength{\hust@bar@xl}{\dimexpr\hust@sec@xl + \hust@bar@pad + \hust@bar@step * \numexpr\hust@sub@idx - 1\relax\relax}%
    \setlength{\hust@bar@xr}{\dimexpr\hust@bar@xl + \hust@bar@w\relax}%
    \ifcsname hust@nav@subpage@\the\hust@sec@idx @\the\hust@sub@idx\endcsname
      \expandafter\let\expandafter\hust@cur@subpage\csname hust@nav@subpage@\the\hust@sec@idx @\the\hust@sub@idx\endcsname
    \else
      \def\hust@cur@subpage{}%
    \fi
    \fill[hustgray] ([xshift=\hust@bar@xl, yshift=\hust@bar@ybot] current page.north west) rectangle
      ([xshift=\hust@bar@xr, yshift=\hust@bar@ytop] current page.north west);
    \ifx\hust@cur@subpage\@empty\else
      \node[anchor=south west, inner sep=0pt, outer sep=0pt]
        at ([xshift=\hust@bar@xl, yshift=\hust@bar@ybot] current page.north west) {%
          \hyperlink{Navigation\hust@cur@subpage}{\phantom{\rule{\hust@bar@w}{\dimexpr\hust@bar@ytop - \hust@bar@ybot + 2.5pt\relax}}}%
        };
    \fi
    \advance\hust@sub@idx by 1\relax
    \expandafter\hust@draw@subbars@inactive
  \fi
}

\newdimen\hust@prog@texty

\newcommand{\hust@render@secloop}{%
  \ifnum\hust@sec@idx>\hust@sec@total\else
    \setlength{\hust@sec@xl}{\dimexpr\hust@sec@w * \numexpr\hust@sec@idx - 1\relax\relax}%
    \setlength{\hust@sec@xr}{\dimexpr\hust@sec@w * \hust@sec@idx\relax}%
    \setlength{\hust@sec@xm}{\dimexpr\hust@sec@xl + \hust@sec@w / 2\relax}%
    \ifcsname hust@nav@secshort@\the\hust@sec@idx\endcsname
      \expandafter\let\expandafter\hust@cur@stitle\csname hust@nav@secshort@\the\hust@sec@idx\endcsname
    \else
      \def\hust@cur@stitle{}%
    \fi
    \ifcsname hust@nav@secpage@\the\hust@sec@idx\endcsname
      \expandafter\let\expandafter\hust@cur@spage\csname hust@nav@secpage@\the\hust@sec@idx\endcsname
    \else
      \def\hust@cur@spage{}%
    \fi
    \ifcsname hust@nav@subcount@\the\hust@sec@idx\endcsname
      \hust@sub@total=\csname hust@nav@subcount@\the\hust@sec@idx\endcsname\relax
    \else
      \hust@sub@total=0\relax
    \fi
    \ifnum\hust@sec@idx=\c@section\relax
      \fill[hustmain] ([xshift=\hust@sec@xl] current page.north west) rectangle
        ([xshift=\hust@sec@xr, yshift=-\hust@prog@h] current page.north west);
      \ifx\hust@cur@spage\@empty\else
        \node[anchor=north west, inner sep=0pt, outer sep=0pt]
          at ([xshift=\hust@sec@xl] current page.north west) {%
            \hyperlink{Navigation\hust@cur@spage}{\phantom{\rule{\hust@sec@w}{\hust@prog@h}}}%
          };
      \fi
      \node[anchor=center, inner sep=0pt, outer sep=0pt, align=center, text width=\dimexpr\hust@sec@w - 4pt\relax]
        at ([xshift=\hust@sec@xm, yshift=\hust@prog@texty] current page.north west) {%
          \ifx\hust@cur@spage\@empty
            {\fontsize{6pt}{6.8pt}\linespread{0.82}\selectfont\bfseries\color{white}\husttruncateto{\dimexpr\hust@sec@w - 4.5pt\relax}{\fontsize{6pt}{6.8pt}\selectfont\bfseries}{\hust@cur@stitle}}%
          \else
            \hyperlink{Navigation\hust@cur@spage}{{\fontsize{6pt}{6.8pt}\linespread{0.82}\selectfont\bfseries\color{white}\husttruncateto{\dimexpr\hust@sec@w - 4.5pt\relax}{\fontsize{6pt}{6.8pt}\selectfont\bfseries}{\hust@cur@stitle}}}%
          \fi
        };
      \ifnum\hust@sub@total>0\relax
        \setlength{\hust@bar@pad}{4pt}%
        \setlength{\hust@bar@gap}{2.2pt}%
        \setlength{\hust@bar@avail}{\dimexpr\hust@sec@w - 2\hust@bar@pad - \hust@bar@gap * \numexpr\hust@sub@total - 1\relax\relax}%
        \setlength{\hust@bar@w}{\dimexpr\hust@bar@avail / \hust@sub@total\relax}%
        \setlength{\hust@bar@step}{\dimexpr\hust@bar@w + \hust@bar@gap\relax}%
        \hust@sub@idx=1\relax
        \hust@draw@subbars@active
      \fi
    \else
      \fill[white] ([xshift=\hust@sec@xl] current page.north west) rectangle
        ([xshift=\hust@sec@xr, yshift=-\hust@prog@h] current page.north west);
      \ifx\hust@cur@spage\@empty\else
        \node[anchor=north west, inner sep=0pt, outer sep=0pt]
          at ([xshift=\hust@sec@xl] current page.north west) {%
            \hyperlink{Navigation\hust@cur@spage}{\phantom{\rule{\hust@sec@w}{\hust@prog@h}}}%
          };
      \fi
      \node[anchor=center, inner sep=0pt, outer sep=0pt, align=center, text width=\dimexpr\hust@sec@w - 4pt\relax]
        at ([xshift=\hust@sec@xm, yshift=\hust@prog@texty] current page.north west) {%
          \ifx\hust@cur@spage\@empty
            {\fontsize{6pt}{6.8pt}\linespread{0.82}\selectfont\bfseries\color{hustblack}\husttruncateto{\dimexpr\hust@sec@w - 4.5pt\relax}{\fontsize{6pt}{6.8pt}\selectfont\bfseries}{\hust@cur@stitle}}%
          \else
            \hyperlink{Navigation\hust@cur@spage}{{\fontsize{6pt}{6.8pt}\linespread{0.82}\selectfont\bfseries\color{hustblack}\husttruncateto{\dimexpr\hust@sec@w - 4.5pt\relax}{\fontsize{6pt}{6.8pt}\selectfont\bfseries}{\hust@cur@stitle}}}%
          \fi
        };
      \ifnum\hust@sub@total>0\relax
        \setlength{\hust@bar@pad}{4pt}%
        \setlength{\hust@bar@gap}{2.2pt}%
        \setlength{\hust@bar@avail}{\dimexpr\hust@sec@w - 2\hust@bar@pad - \hust@bar@gap * \numexpr\hust@sub@total - 1\relax\relax}%
        \setlength{\hust@bar@w}{\dimexpr\hust@bar@avail / \hust@sub@total\relax}%
        \setlength{\hust@bar@step}{\dimexpr\hust@bar@w + \hust@bar@gap\relax}%
        \hust@sub@idx=1\relax
        \hust@draw@subbars@inactive
      \fi
    \fi
    \draw[hustgrayline!40, line width=0.4pt]
      ([xshift=\hust@sec@xr] current page.north west) --
      ([xshift=\hust@sec@xr, yshift=-\hust@prog@h] current page.north west);
    \advance\hust@sec@idx by 1\relax
    \expandafter\hust@render@secloop
  \fi
}

\newcommand{\hust@render@progressbar}{%
  \ifnum\hust@nav@totalsecs=0\relax
    \hust@read@nav
  \fi
  \hust@sec@total=\hust@nav@totalsecs\relax
  \ifnum\hust@sec@total>0\relax
    \setlength{\hust@sec@w}{\dimexpr\paperwidth / \hust@sec@total\relax}%
    \setlength{\hust@prog@texty}{\dimexpr-\hust@prog@h * 4 / 10\relax}%
    \setlength{\hust@bar@ybot}{\dimexpr-\hust@prog@h + 2pt\relax}%
    \setlength{\hust@bar@ytop}{\dimexpr-\hust@prog@h + 3.5pt\relax}%
    \hust@sec@idx=1\relax
    \hust@render@secloop
  \fi
}

\newdimen\hust@cur@progh
\newif\ifhust@framenoprogressbar
\hust@framenoprogressbarfalse

\define@key{beamerframe}{noprogressbar}[]{\global\hust@framenoprogressbartrue}

\newcommand{\hust@eval@progh}{%
  \hust@cur@progh=0pt\relax
  \ifx\hust@progressbar\hust@opt@on
    \hust@cur@progh=\dimexpr\hust@prog@h\relax
    \ifnum\c@section=0\relax
      \hust@cur@progh=0pt\relax
    \fi
    \ifhust@framenoprogressbar
      \hust@cur@progh=0pt\relax
    \fi
  \fi
}


%% ----------------------------------------------------------- Header / Headline
\def\hust@hdr@pagenumber{pagenumber}
\def\hust@hdr@logo{logo}
\newsavebox\hust@hdr@rightbox
\newdimen\hust@cur@bandH
\newdimen\hust@cur@headerB
\newdimen\hust@title@avail@w

\newcommand{\hust@eval@header@dims}{%
  \def\hust@bar@thick{thick}%
  \ifx\hust@bar\hust@bar@thick
    \setlength{\hust@cur@bandH}{\hust@fH{bandB}}%
    \setlength{\hust@cur@headerB}{\hust@fH{thickB}}%
  \else
    \setlength{\hust@cur@bandH}{\hust@fH{bandThinB}}%
    \setlength{\hust@cur@headerB}{\hust@fH{thinB}}%
  \fi
  \sbox\hust@hdr@rightbox{}%
  \ifx\hust@headerright\hust@hdr@pagenumber
    \ifx\hust@numbering\hust@num@none\else
      \sbox\hust@hdr@rightbox{%
        {\usebeamerfont{frametitle}\color{hustsubyellow}\strut%
          \ifx\hust@numbering\hust@num@fraction
            \insertframenumber/\inserttotalframenumber
          \else
            \insertframenumber
          \fi
        \strut}%
      }%
    \fi
  \else\ifx\hust@headerright\hust@hdr@logo
    \ifx\hust@headerlogo\@empty\else
      \sbox\hust@hdr@rightbox{%
        \begingroup
          \setlength{\fboxsep}{1.4pt}%
          \colorbox{white}{%
            \includegraphics[height=\dimexpr\hust@cur@bandH - 8.0pt\relax,keepaspectratio]{\hust@headerlogo}%
          }%
        \endgroup
      }%
    \fi
  \fi\fi
  \ifdim\wd\hust@hdr@rightbox>0pt\relax
    \setlength{\hust@title@avail@w}{\dimexpr\paperwidth - 2\hust@fW{mL} - \wd\hust@hdr@rightbox - 0.8em\relax}%
  \else
    \setlength{\hust@title@avail@w}{\dimexpr\paperwidth - 2\hust@fW{mL}\relax}%
  \fi
}

\defbeamertemplate*{headline}{HUST}{%
  \leavevmode%
  \hust@eval@progh
  \hust@eval@header@dims
  \begin{tikzpicture}[remember picture, overlay]
    %% Optional diagonal rounded-diamond texture from HUST Brand Guidebook Page 1 (compact bottom-right accent)
    \ifx\hust@framebg\hust@opt@on
      \hust@resolve@diagimg
      \def\hust@cur@framebgh{%
        \ifx\hust@framebg@height\hust@val@auto
          \ifhust@wide 0.26\paperheight\else 0.24\paperheight\fi
        \else
          \hust@framebg@height
        \fi
      }%
      \node[inner sep=0pt, outer sep=0pt, anchor=south east, opacity=\hust@framebg@opacity]
        at ([xshift=0pt, yshift=-\dimexpr\hust@fH{footY} - 1.5pt\relax] current page.north east) {%
          \includegraphics[height=\hust@cur@framebgh,keepaspectratio]{\hust@diag@img}%
        };
    \fi
    %% Progress bar at the top (if enabled and current frame allows)
    \ifdim\hust@cur@progh>0pt\relax
      \hust@render@progressbar
    \fi
    %% Main coloured header band and accent bar (pushed down by \hust@cur@progh)
    \def\hust@bar@thick{thick}%
    \ifx\hust@bar\hust@bar@thick
      \fill[hustmain] ([yshift=-\hust@cur@progh] current page.north west) rectangle
        ([yshift=-\dimexpr\hust@fH{bandB} + \hust@cur@progh\relax] current page.north east);
      \fill[hustaccent] ([yshift=-\dimexpr\hust@fH{bandB} + \hust@cur@progh\relax] current page.north west) rectangle
        ([yshift=-\dimexpr\hust@fH{thickB} + \hust@cur@progh\relax] current page.north east);
    \else
      \fill[hustmain] ([yshift=-\hust@cur@progh] current page.north west) rectangle
        ([yshift=-\dimexpr\hust@fH{bandThinB} + \hust@cur@progh\relax] current page.north east);
      \fill[hustaccent] ([yshift=-\dimexpr\hust@fH{ruleT} + \hust@cur@progh\relax] current page.north west) rectangle
        ([yshift=-\dimexpr\hust@fH{thinB} + \hust@cur@progh\relax] current page.north east);
    \fi
    %% Right side of frametitle bar: yellow page number or white-bordered logo
    \ifdim\wd\hust@hdr@rightbox>0pt\relax
      \node[anchor=east, inner sep=0pt, outer sep=0pt]
        at ([xshift=-\hust@fW{mL}, yshift=\dimexpr -\hust@cur@progh - \hust@cur@bandH/2\relax] current page.north east) {%
          \usebox\hust@hdr@rightbox
        };
    \fi
  \end{tikzpicture}%
}

\newcommand{\hust@check@hassub}{%
  \gdef\hust@hassub{0}%
  \begingroup
    \setbox\z@=\hbox{\normalfont\insertframesubtitle}%
    \ifdim\wd\z@>0pt\relax
      \protected@edef\hust@cur@sub{\insertframesubtitle}%
      \ifdefstring{\hust@cur@sub}{Hidden}{}{%
        \ifdefstring{\hust@cur@sub}{hidden}{}{%
          \ifdefstring{\hust@cur@sub}{none}{}{%
            \gdef\hust@hassub{1}%
          }%
        }%
      }%
    \fi
  \endgroup
}

%% ----------------------------------------------------------------- Frametitle
\defbeamertemplate*{frametitle}{HUST}[1][left]{%
  \nointerlineskip%
  \hust@eval@progh
  \hust@eval@header@dims
  \hust@check@hassub
  \def\hust@bar@thick{thick}%
  \ifx\hust@bar\hust@bar@thick
    \vskip\dimexpr\hust@fH{thickB} + \hust@cur@progh + 0.3em\relax%
  \else
    \vskip\dimexpr\hust@fH{thinB} + \hust@cur@progh + 0.4em\relax%
  \fi
  \begin{tikzpicture}[remember picture, overlay]
    \def\hust@bar@thick{thick}%
    \ifx\hust@bar\hust@bar@thick
      %% THICK BAR MODE: Subtitle moves into the thick accent bar with white text
      \node[anchor=west, inner sep=0pt, outer sep=0pt]
        at ([xshift=\hust@fW{mL}, yshift=\dimexpr -\hust@cur@progh - \hust@fH{bandB}/2\relax] current page.north west) {%
          \parbox{\hust@title@avail@w}{\usebeamerfont{frametitle}\color{white}\raggedright\strut\husttruncateto{\hust@title@avail@w}{\usebeamerfont{frametitle}}{\insertframetitle}\strut}%
        };
      \ifnum\hust@hassub=1\relax
        \node[anchor=west, inner sep=0pt, outer sep=0pt]
          at ([xshift=\hust@fW{mL}, yshift=\dimexpr -\hust@cur@progh - (\hust@fH{bandB} + \hust@fH{thickB})/2\relax] current page.north west) {%
            \parbox{\dimexpr\paperwidth - 2\hust@fW{mL}\relax}{\usebeamerfont{framesubtitle}\color{HUSTWhite}\spaceskip=0.8\fontdimen2\font\raggedright\strut\husttruncateto{\dimexpr\paperwidth - 2\hust@fW{mL}\relax}{\usebeamerfont{framesubtitle}}{\insertframesubtitle}\strut}%
          };
      \fi
    \else
      %% THIN BAR MODE: Standard layout
      \ifnum\hust@hassub=0\relax
        %% Single-line title: mathematically centered in the colored header band
        \node[anchor=west, inner sep=0pt, outer sep=0pt]
          at ([xshift=\hust@fW{mL}, yshift=\dimexpr -\hust@cur@progh - \hust@fH{bandThinB}/2\relax] current page.north west) {%
            \parbox{\hust@title@avail@w}{\usebeamerfont{frametitle}\color{white}\raggedright\strut\husttruncateto{\hust@title@avail@w}{\usebeamerfont{frametitle}}{\insertframetitle}\strut}%
          };
      \else
        %% Title + Subtitle: vertically centered as a 2-line block inside the colored header band
        \node[anchor=west, inner sep=0pt, outer sep=0pt]
          at ([xshift=\hust@fW{mL}, yshift=\dimexpr -\hust@cur@progh - \hust@fH{bandThinB}/2\relax] current page.north west) {%
            \parbox{\hust@title@avail@w}{%
              {\usebeamerfont{frametitle}\color{white}\raggedright\strut\husttruncateto{\hust@title@avail@w}{\usebeamerfont{frametitle}}{\insertframetitle}\strut\par}%
              \nointerlineskip\vskip 1.5pt%
              {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\spaceskip=0.8\fontdimen2\font\raggedright\strut\husttruncateto{\hust@title@avail@w}{\usebeamerfont{framesubtitle}}{\insertframesubtitle}\strut\par}%
            }%
          };
      \fi
    \fi
  \end{tikzpicture}%
}

%% ----------------------------------------------------------- Footer / Footline
\def\hust@logo@full{full}
\def\hust@logo@mark{mark}
\def\hust@logo@wordmark{wordmark}
\def\hust@logo@hust{hust}
\def\hust@logo@none{none}

\def\hust@num@none{none}
\def\hust@num@plain{plain}
\def\hust@num@fraction{fraction}

\defbeamertemplate*{footline}{HUST}{%
  \leavevmode%
  \begin{tikzpicture}[remember picture, overlay]
    %% Calculate logo file, width, and gap
    \def\hust@fimg{}%
    \def\hust@lw{0pt}%
    \def\hust@lgap{0pt}%
    \ifx\hust@flogo\hust@logo@full
      \def\hust@fimg{footer-full.png}%
      \def\hust@lw{\hust@fW{fullW}}%
      \def\hust@lgap{\hust@fW{gapfull}}%
    \else\ifx\hust@flogo\hust@logo@mark
      \def\hust@fimg{footer-mark.png}%
      \def\hust@lw{\hust@fW{markW}}%
      \def\hust@lgap{\hust@fW{gapmark}}%
    \else\ifx\hust@flogo\hust@logo@wordmark
      \def\hust@fimg{footer-wordmark.png}%
      \def\hust@lw{\hust@fW{wordmarkW}}%
      \def\hust@lgap{\hust@fW{gapwordmark}}%
    \else\ifx\hust@flogo\hust@logo@hust
      \def\hust@fimg{footer-hust.png}%
      \def\hust@lw{\hust@fW{hustW}}%
      \def\hust@lgap{\hust@fW{gaphust}}%
    \fi\fi\fi\fi

    %% Place footer logo at bottom left (centred vertically on footY)
    \ifx\hust@fimg\@empty\else
      \node[inner sep=0pt, outer sep=0pt, anchor=west]
        at ([xshift=\hust@fW{footX}, yshift=-\hust@fH{footY}] current page.north west) {%
        \includegraphics[width=\hust@lw]{\hust@fimg}%
      };
    \fi

    %% Dynamic footer bar & citations placement:
    %% If 0 citations: original bar at footY, and \hust@footertext above bar (if set).
    %% If 1 citation: original bar at footY, and citation placed UNDER the bar.
    %% If 2+ citations: citations textbox pulled close to bottom edge (numY),
    %%                  and footer bar redrawn directly ABOVE the citations textbox.
    \ifnum\c@hust@slide@citecount=0\relax
      \ifhust@footermeta
        %% Check whether slide page number is rendered in the footer or moved to the header bar
        \def\hust@show@footnum{1}%
        \ifx\hust@numbering\hust@num@none
          \def\hust@show@footnum{0}%
        \fi
        \ifx\hust@headerright\hust@hdr@pagenumber
          \def\hust@show@footnum{0}%
        \fi
        \ifnum\hust@show@footnum=0\relax
          %% Page number moved to header (or disabled): Date is right-aligned at footXend with wider spacing
          \node[anchor=south east, inner sep=0pt, outer sep=0pt] (hustdate)
            at ([xshift=\hust@fW{footXend}, yshift=-\hust@fH{numY}] current page.north west) {%
            {\usebeamerfont{footermeta}\color{hustmain}\strut\hust@cur@footerdate}%
          };
        \else
          %% 1. Slide numbering (right aligned at numR)
          \node[anchor=south east, inner sep=0pt, outer sep=0pt] (hustpagenum)
            at ([xshift=\hust@fW{numR}, yshift=-\hust@fH{numY}] current page.north west) {%
            {\usebeamerfont{page number in head/foot}\color{hustmain}\strut%
              \ifx\hust@numbering\hust@num@fraction
                \insertframenumber\,/\,\inserttotalframenumber
              \else
                \insertframenumber
              \fi
            }%
          };
          %% 2. Date: to the left of page number
          \node[anchor=south east, inner sep=0pt, outer sep=0pt] (hustdate)
            at ([xshift=-1.5em] hustpagenum.south west) {%
            {\usebeamerfont{footermeta}\color{hustmain}\strut\hust@cur@footerdate}%
          };
        \fi
        %% 3. Author: bottom left after logo
        \node[anchor=south west, inner sep=0pt, outer sep=0pt] (hustauthor)
          at ([xshift=\dimexpr\hust@fW{footX} + \hust@lw + \hust@lgap\relax, yshift=-\hust@fH{numY}] current page.north west) {%
          {\usebeamerfont{footermeta}\color{hustmain}\strut\hust@cur@footerauthor}%
        };
        %% 4. Title: between author and date, multi-line if needed, anchored to bottom
        \path let \p1 = (hustauthor.south east),
                  \p2 = (hustdate.south west),
                  \n1 = {\x2 - \x1 - 2.0em} in
          node[anchor=south, inner sep=0pt, outer sep=0pt] (husttitle) at ({(\x1+\x2)/2}, \y1) {%
            \parbox[b]{\n1}{%
              \centering\usebeamerfont{footermeta}\color{hustmain}\strut%
              \hust@cur@footertitle\strut
            }%
          };
        %% 5. Accent rule: stays at footY if 1 line, or lifts up if title has multiple lines
        \path let \p1 = ([yshift=3.5pt] husttitle.north),
                  \p2 = ([yshift=-\hust@fH{footY}] current page.north west),
                  \n2 = {max(\y1, \y2)} in
          coordinate (actualRuleY) at (0pt, \n2);
        \draw[hustaccent, line width=\hust@fH{footLineH}]
          ([xshift=\dimexpr\hust@fW{footX} + \hust@lw + \hust@lgap\relax] current page.north west |- actualRuleY) --
          ([xshift=\hust@fW{footXend}] current page.north west |- actualRuleY);
      \fi
      \ifhust@footermeta\else
        \draw[hustaccent, line width=\hust@fH{footLineH}]
          ([xshift=\dimexpr\hust@fW{footX} + \hust@lw + \hust@lgap\relax, yshift=-\hust@fH{footY}] current page.north west) --
          ([xshift=\hust@fW{footXend}, yshift=-\hust@fH{footY}] current page.north west);
        \ifx\hust@footertext\@empty\else
          \node[anchor=south west, inner sep=0pt, outer sep=0pt]
            at ([xshift=\dimexpr\hust@fW{footX} + \hust@lw + \hust@lgap\relax, yshift=\dimexpr-\hust@fH{footY} + 2pt\relax] current page.north west) {%
            {\usebeamerfont{footer}\color{hustblack}\hust@footertext}%
          };
        \fi
      \fi
    \fi
    \ifnum\c@hust@slide@citecount>0\relax
      \hust@build@slide@citebox
    \fi
    \ifnum\hust@cite@rows=1\relax
      \draw[hustaccent, line width=\hust@fH{footLineH}]
        ([xshift=\dimexpr\hust@fW{footX} + \hust@lw + \hust@lgap\relax, yshift=-\hust@fH{footY}] current page.north west) --
        ([xshift=\hust@fW{footXend}, yshift=-\hust@fH{footY}] current page.north west);
      \node[anchor=north west, inner sep=0pt, outer sep=0pt]
        at ([xshift=\dimexpr\hust@fW{footX} + \hust@lw + \hust@lgap\relax, yshift=\dimexpr-\hust@fH{footY} - 2pt\relax] current page.north west) {%
          \copy\hust@slide@citebox
        };
    \fi
    \ifnum\hust@cite@rows>1\relax
      \node[anchor=south west, inner sep=0pt, outer sep=0pt] (hustcites)
        at ([xshift=\dimexpr\hust@fW{footX} + \hust@lw + \hust@lgap\relax, yshift=-\hust@fH{numY}] current page.north west) {%
          \copy\hust@slide@citebox
        };
      \coordinate (citeruleL) at ([yshift=3pt] hustcites.north west);
      \draw[hustaccent, line width=\hust@fH{footLineH}]
        (citeruleL) -- ([xshift=\hust@fW{footXend}] current page.north west |- citeruleL);
    \fi

    %% Slide numbering (right aligned at numR) - drawn here when footermeta is off or when cites are active, unless moved to header
    \ifx\hust@headerright\hust@hdr@pagenumber\else
      \ifhust@footermeta
        \ifnum\c@hust@slide@citecount>0\relax
          \ifx\hust@numbering\hust@num@none\else
            \node[anchor=east, inner sep=0pt, outer sep=0pt]
              at ([xshift=\hust@fW{numR}, yshift=-\hust@fH{numY}] current page.north west) {%
              {\usebeamerfont{page number in head/foot}\color{hustmain}%
                \ifx\hust@numbering\hust@num@fraction
                  \insertframenumber\,/\,\inserttotalframenumber
                \else
                  \insertframenumber
                \fi
              }%
            };
          \fi
        \fi
      \else
        \ifx\hust@numbering\hust@num@none\else
          \node[anchor=east, inner sep=0pt, outer sep=0pt]
            at ([xshift=\hust@fW{numR}, yshift=-\hust@fH{numY}] current page.north west) {%
            {\usebeamerfont{page number in head/foot}\color{hustmain}%
              \ifx\hust@numbering\hust@num@fraction
                \insertframenumber\,/\,\inserttotalframenumber
              \else
                \insertframenumber
              \fi
            }%
          };
        \fi
      \fi
    \fi
  \end{tikzpicture}%
  \vskip\dimexpr\paperheight - \hust@fH{bodyBot}\relax%
  \global\setbox\hust@slide@citebox=\box\voidb@x%
  \global\c@hust@slide@citecount=0\relax%
  \gdef\hust@cite@rows{0}%
  \global\c@footnote=0\relax%
}

